{
  "buildCommand": "node scripts/reel-vcr-preview-bootstrap.mjs && npm run build",
  "functions": {
    "api/queues/reel-render.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "servicescope-reel-render-v1",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/auth/meta/callback",
      "destination": "/index.html"
    }
  ]
}
